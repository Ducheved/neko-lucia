{
  "name": "neko-lucia-monorepo",
  "version": "0.1.0",
  "description": "Server-side sessions for Node and Deno with Lucia v3 migration support",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "build": "pnpm -r run build",
    "build:lucia": "pnpm --filter @ducheved/neko-lucia run build",
    "format": "prettier --write eslint.config.mjs \"packages/**/*.{ts,mjs}\" \"tests/**/*.{ts,mjs}\"",
    "format:check": "prettier --check eslint.config.mjs \"packages/**/*.{ts,mjs}\" \"tests/**/*.{ts,mjs}\"",
    "lint": "pnpm run build:lucia && pnpm run lint-only",
    "lint-only": "eslint \"packages/**/*.ts\" \"tests/**/*.ts\"",
    "test": "pnpm run build:lucia && pnpm run test-only",
    "test-only": "pnpm -r run test",
    "test:deno": "deno run --sloppy-imports --node-modules-dir=manual tests/deno-smoke.mjs",
    "typecheck": "pnpm run build:lucia && pnpm run typecheck-only",
    "typecheck-only": "pnpm -r run typecheck",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "author": "Ducheved",
  "license": "MIT",
  "homepage": "https://github.com/Ducheved/neko-lucia#readme",
  "bugs": {
    "url": "https://github.com/Ducheved/neko-lucia/issues"
  },
  "engines": {
    "deno": ">=2.9.0",
    "node": "^22.23.1 || ^24.18.0 || ^26.0.0",
    "pnpm": ">=11.14.0"
  },
  "devDependencies": {
    "@ducheved/neko-lucia": "workspace:*",
    "@ducheved/neko-lucia-adapter-drizzle": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "drizzle-orm": "0.45.2",
    "eslint": "10.8.0",
    "eslint-plugin-n": "18.2.2",
    "prettier": "3.9.6",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
